# Copy this file to .env and fill in real values. Never commit .env.

# ---- Alpaca ----
# Paper trading endpoint by default. Switch to live only when ready.
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex          # iex | sip

# ---- News provider (e.g. NewsAPI, Alpaca News, Benzinga) ----
NEWS_API_KEY=your_news_api_key_here
NEWS_PROVIDER=alpaca          # alpaca | newsapi | benzinga

# ---- Database ----
DATABASE_URL=sqlite:///data/esther.db
# Example Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/esther

# ---- Runtime ----
APP_ENV=dev                   # dev | staging | prod
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true to emit JSON logs

# ---- Sentiment model ----
SENTIMENT_MODEL=ProsusAI/finbert
SENTIMENT_DEVICE=cpu          # cpu | cuda | mps

# ---- AI summaries (Anthropic) ----
# Required for `esther summarize` and the dashboard "AI brief" panel.
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_MODEL=claude-opus-4-7     # Anthropic model id; do NOT append a date suffix
LLM_MAX_TOKENS=1024
