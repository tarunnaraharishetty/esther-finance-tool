# Copy this file to .env and fill in real values. Never commit .env.
#
# Settings whose default is fine for local dev are left commented; the
# value shown after the `#` is the default the codebase ships with.
# Settings marked REQUIRED IN PROD are rejected at startup by
# src/config/settings.py's model validator when APP_ENV != "dev".

# =====================================================================
# Runtime
# =====================================================================
APP_ENV=dev                   # dev | staging | prod
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true to emit JSON logs (recommended in prod)

# =====================================================================
# Auth + sessions — REQUIRED IN PROD
# =====================================================================
# Cookie signing key. Anything ≥32 random bytes is fine; the model
# validator refuses the committed dev default outside APP_ENV=dev.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=replace-me-with-a-long-random-string

# Mark session cookies Secure. REQUIRED True in prod (the validator
# refuses False). Keep False only for plain-HTTP localhost testing.
SECURE_COOKIES=false

# SESSION_TTL_DAYS=30
# SESSION_COOKIE_NAME=esther_session

# Disable auth entirely (single-user dev): USER_STORE_PATH=
# Default lives at data/users.db; persist this across deploys.
# USER_STORE_PATH=

# Symbols a fresh user's watchlist is seeded with on signup.
# DEFAULT_WATCHLIST_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,TSLA

# =====================================================================
# Password reset
# =====================================================================
# Token TTL. 1h is standard.
# PASSWORD_RESET_TTL_HOURS=1

# Base URL the reset link points at. When unset, the route builds
# it from request.url — fine for same-origin Render-style deploys.
# Set when API + frontend live on different hosts.
# PASSWORD_RESET_BASE_URL=https://esther.example.com

# =====================================================================
# Email transport — optional
# =====================================================================
# When SMTP_HOST is unset, reset links land in the structured log
# so the operator can relay manually (fine for closed beta). Set
# the whole quintuple to enable real email delivery via any
# SMTP provider (SendGrid / SES / Mailgun / Postmark / Gmail...).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_smtp_password_or_api_token
# SMTP_SENDER=Esther <noreply@esther.example.com>

# =====================================================================
# HTTP — REQUIRED IN PROD
# =====================================================================
# Hostnames the server will answer for (Host header allow-list). The
# validator refuses "*" outside dev. Comma-separated or JSON list.
TRUSTED_HOSTS=*

# Cross-origin allow-list for the frontend. Default = Vite dev server.
# In a same-origin deploy (FastAPI also serves web/dist/) this is
# irrelevant. The validator refuses "*" outside dev because FastAPI's
# CORS middleware silently breaks allow_credentials=True + wildcard.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set True when behind a reverse proxy (Render, Railway, Fly, nginx,
# Cloudflare). Trusts X-Forwarded-For for rate-limit keying AND
# X-Forwarded-Proto for request.url.scheme. NEVER True when the
# server is internet-reachable directly — XFF is attacker-controlled.
# TRUST_PROXY_HEADERS=false

# =====================================================================
# Alpaca (market data) — REQUIRED
# =====================================================================
# Paper trading endpoint by default. The data layer refuses live URLs
# at startup unless the operator explicitly flips them.
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex          # iex | sip

# =====================================================================
# News
# =====================================================================
NEWS_PROVIDER=alpaca          # alpaca | newsapi | benzinga
# NEWS_API_KEY=                # required only for newsapi / benzinga

# =====================================================================
# Fundamentals providers (all optional — chain falls through)
# =====================================================================
# Provider chain order. Keyed providers ahead of scraped fallbacks.
# FUNDAMENTALS_PROVIDER_ORDER=fmp,finnhub,alpha_vantage,sec_edgar,yahoo
# FUNDAMENTALS_CACHE_TTL_HOURS=12

# Per-provider keys. Each unset key silently skips that provider.
# FMP_API_KEY=
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=

# SEC EDGAR mandates a contact User-Agent. Empty disables the provider
# rather than sending a generic UA. Format: "App Name contact@example.com".
# SEC_EDGAR_USER_AGENT=

# =====================================================================
# AI summaries (Anthropic) — optional
# =====================================================================
# Required for `esther summarize`, the dashboard AI brief panel, the
# research thesis (LLM mode), and the compare narrative. Unset falls
# back to deterministic template implementations.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-4-7
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE=0

# =====================================================================
# Persistence (paths default to ./data/, can be remapped for volume mounts)
# =====================================================================
# DATABASE_URL=sqlite:///data/esther.db
# Example Postgres: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/esther

# Per-provider health log + SLO endpoint. Empty disables.
# HEALTH_STORE_PATH=data/health.db

# Durable retry queue for transient fundamentals failures. Empty disables.
# RETRY_QUEUE_PATH=data/retry_queue.db
# RETRY_QUEUE_WORKER_ENABLED=false
# RETRY_QUEUE_MAX_ATTEMPTS=5

# Calibration store (forward-looking score → hit-rate buckets).
# CALIBRATION_STORE_PATH=data/calibration.db
# CALIBRATION_MATURATION_ENABLED=false

# Intelligence-layer snapshot (signal history, OPP membership, etc).
# SESSION_STATE_PATH=data/session_state.json

# =====================================================================
# Sentiment model
# =====================================================================
# SENTIMENT_MODEL=ProsusAI/finbert
# SENTIMENT_DEVICE=cpu          # cpu | cuda | mps

# =====================================================================
# Dashboard cadence
# =====================================================================
# DASHBOARD_REFRESH_SECONDS=5.0
# DASHBOARD_BURST_SECONDS=1.5

# =====================================================================
# Multi-timeframe
# =====================================================================
# INTRADAY_ENABLED=false
# INTRADAY_TIMEFRAME=15Min
# INTRADAY_LOOKBACK_DAYS=5
